<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body style = "text-align: center;">
    <h1>Admin Page</h1>
    <% list.forEach(contact => { %>
        <h2>Contact Information From <%= contact.fname %> <%= contact.lname %></h2>
        <p><b>First Name:</b> <%= contact.fname %></p>
        <p><b>Last Name:</b> <%= contact.lname %></p>
        <p><b>Job Title:</b> <%= contact.jtitle %></p>
        <p><b>Company Name:</b> <%= contact["company-name"] %></p>
        <p><b>Linkedin URL:</b> <%= contact.linkedinUrl %></p>
        <p><b>Email:</b> <%= contact.email %></p>
        <p><b>Met Option:</b> <%= contact.metOption %></p>
        <p><b>Other Option</b> <%= contact["other-option"] %></p>
        <p><b>Message:</b> <%= contact.message %></p>
        <p><b>Mailing List:</b><%= contact.mailingList %></p>
        <p><b>Format:</b> <%= contact.format %></p>

    <% });%>
    <footer style = "display: flex; justify-content: center; margin-top: 3rem;">
        <span>GitHub Link: <a href="https://github.com/Ali200674/contact-form">Here</a></span>
    </footer>
</body>
</html>